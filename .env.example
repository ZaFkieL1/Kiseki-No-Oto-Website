# Firebase web config. NOT secret — Astro inlines every PUBLIC_ variable into
# the bundle the browser downloads. It lives here so the public repository is
# not a list of people's addresses and does not trip secret scanners; the key
# itself is protected by referrer restrictions in Google Cloud Console.
PUBLIC_FIREBASE_API_KEY=AIzaSy...
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# What KERNEL shows, not what it allows. Lowercase, comma separated.
PUBLIC_EDITORS=you@example.com
